<Window x:Class="MagicKeywords.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MagicKeywords"
        Title="Magic: The Gathering Keyword Guide" Width="1100" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Segoe UI" Foreground="#111111">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#111111" />
        <SolidColorBrush x:Key="Muted" Color="#6B6B6B" />
        <SolidColorBrush x:Key="Panel" Color="#F5F5F5" />
        <SolidColorBrush x:Key="Line" Color="#E2E2E2" />

        <!-- Uppercase nav tab with underline when selected -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bar" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="2,18,2,12" Margin="0,0,28,0" Background="Transparent">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="13" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink}" />
                                <Setter TargetName="Bar" Property="BorderBrush" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="Transparent" x:Name="Box">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink}" />
                                <Setter TargetName="Box" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="14,9" CornerRadius="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Panel}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Ink}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Black pill button; outlined when off, filled when favorited -->
        <Style x:Key="FavStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Pill" CornerRadius="20" BorderThickness="2" BorderBrush="{StaticResource Ink}" Background="White" Padding="20,9">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Ink}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Ink}" />
                                <Setter TargetName="Label" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header / nav bar -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}" Padding="32,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="MTG KEYWORDS" FontSize="20" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,48,0" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModeSearch" Content="SEARCH" Style="{StaticResource NavTab}" GroupName="m" IsChecked="True" Checked="ModeChanged" />
                    <RadioButton x:Name="ModeGlossary" Content="GLOSSARY" Style="{StaticResource NavTab}" GroupName="m" Checked="ModeChanged" />
                    <RadioButton x:Name="ModeFavorites" Content="★ FAVORITES" Style="{StaticResource NavTab}" GroupName="m" Checked="ModeChanged" />
                    <RadioButton x:Name="ModeSim" Content="COMBAT SIM" Style="{StaticResource NavTab}" GroupName="m" Checked="ModeChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
        <Grid x:Name="GuideView" Margin="32,24,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBoxStyle}" Height="42" FontSize="15" Margin="0,0,0,10"
                         TextChanged="FilterChanged" />
                <ComboBox x:Name="KindFilter" DockPanel.Dock="Top" Margin="0,0,0,10" SelectedIndex="0" SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="Keyword Ability" />
                    <ComboBoxItem Content="Keyword Action" />
                </ComboBox>
                <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="{StaticResource Muted}" FontSize="12" />
                <ListBox x:Name="ResultList" BorderThickness="0" SelectionChanged="SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Black" FontSize="12" Foreground="{StaticResource Muted}" Margin="14,14,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Star}" Foreground="#E0A800" />
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                    <TextBlock x:Name="KindText" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,24">
                        <ToggleButton x:Name="FavButton" DockPanel.Dock="Right" Style="{StaticResource FavStyle}" Content="☆ FAVORITE"
                                      VerticalAlignment="Top" Click="FavClicked" />
                        <TextBlock x:Name="NameText" FontSize="40" FontWeight="Black" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="DEFINITION" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                    <TextBlock x:Name="DefText" TextWrapping="Wrap" FontSize="17" LineHeight="26" Margin="0,0,0,32" />
                    <TextBlock Text="EXAMPLES" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="ExampleList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel}" Padding="20,16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Heading}" FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="21" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="Placeholder" Grid.Column="2" Text="Select a keyword to see its definition."
                       Foreground="{StaticResource Muted}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
        <local:CombatView x:Name="SimView" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
