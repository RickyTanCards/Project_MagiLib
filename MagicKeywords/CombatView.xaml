<UserControl x:Class="MagicKeywords.CombatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Foreground="#111111" Background="White">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Ink" Color="#111111" />
        <SolidColorBrush x:Key="Muted" Color="#6B6B6B" />

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="20" Background="{StaticResource Ink}" Padding="20,11">
                            <TextBlock Text="{TemplateBinding Content}" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="SIMULATE COMBAT" Style="{StaticResource PillButton}" Click="RunClicked" />
                <Button Grid.Column="2" Content="SWAP CREATURES" Style="{StaticResource PillButton}" Click="SwapClicked" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Left" Margin="0,0,14,0" />
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="COMBAT LOG" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
            <RichTextBox x:Name="Out" IsReadOnly="True" BorderThickness="0" VerticalScrollBarVisibility="Auto" Padding="0" FontSize="14" />
        </DockPanel>
    </Grid>
</UserControl>
