@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<div class="shell">
    <header class="topbar"><span class="brand">MTG KEYWORDS</span></header>
    <main>
        @Body
    </main>
    <nav class="tabbar" aria-label="Main">
        <NavLink href="" Match="NavLinkMatch.All" class="tab"><span class="ico">⌕</span><span>Search</span></NavLink>
        <NavLink href="glossary" class="tab"><span class="ico">☰</span><span>Glossary</span></NavLink>
        <NavLink href="favorites" class="tab"><span class="ico">★</span><span>Favorites</span></NavLink>
        <NavLink href="sim" class="tab"><span class="ico">⚔</span><span>Combat</span></NavLink>
    </nav>
</div>

@code {
    protected override void OnInitialized() => Nav.LocationChanged += OnNav;

    // Each page starts at the top, like a native navigation push.
    void OnNav(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = JS.InvokeVoidAsync("mk.scrollTop");

    public void Dispose() => Nav.LocationChanged -= OnNav;
}
